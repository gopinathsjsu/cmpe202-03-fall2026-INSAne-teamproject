# Insane Stays Frontend Configuration
# Copy to .env and fill in values.

# Backend API URL
VITE_API_URL=http://localhost:5001

# Google Maps (browser key: Maps JavaScript API + Places API (New))
# Restrict this key to your site's URL in Google Cloud Console.
# Leave empty to run without maps and address autocomplete.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Optional: Map ID for map pins. DEMO_MAP_ID is used if empty.
VITE_GOOGLE_MAPS_MAP_ID=
